{
  "store.custom#campanha-lumix-25-anos": {
    "blocks": [
      "flex-layout.row#campanha-lumix-25-anos-titles",
      "flex-layout.row#campanha-lumix-25-anos-content"
    ]
  },

  "flex-layout.row#campanha-lumix-25-anos-titles": {
    "children": [
      "flex-layout.row#title-institucional",
      "flex-layout.row#title-campanha-lumix-25-anos"
    ],
    "props": {
      "blockClass": "titles-institucional",
      "colGap": 2,
      "fullWidth": true,
      "horizontalAlign": "left",
      "preventVerticalStretch": true
    }
  },

  "flex-layout.row#campanha-lumix-25-anos-content": {
    "children": [
      "flex-layout.col#institucional-nav-bar",
      "flex-layout.col#campanha-lumix-25-anos"
    ],
    "props": {
      "blockClass": "conteudo-institucional",
      "colGap": 2,
      "fullWidth": true,
      "horizontalAlign": "left",
      "preventVerticalStretch": true
    }
  },

  "flex-layout.col#campanha-lumix-25-anos": {
    "children": [
      "iframe#regulamento-lumix-25-anos"
    ],
    "props": {
      "width": "70%",
      "preventVerticalStretch": true,
      "blockClass": "conteudo-regulamento-lumix"
    }
  },

  "flex-layout.row#title-institucional": {
    "children": [
      "rich-text#title-institucional"
    ],
    "props": {
      "width": "25%",
      "preventVerticalStretch": true
    }
  },

  "flex-layout.row#title-campanha-lumix-25-anos": {
    "children": [
      "rich-text#title-campanha-lumix-25-anos"
    ],
    "props": {
      "width": "70%",
      "preventVerticalStretch": true
    }
  },

  "rich-text#title-institucional": {
    "props": {
      "blockClass": [
        "titulo-institucional",
        "titulo-campanha-lumix-25-anos"
      ],
      "text": "# Institucional"
    }
  },

  "rich-text#title-campanha-lumix-25-anos": {
    "props": {
      "blockClass": [
        "titulo-institucional",
        "titulo-campanha-lumix-25-anos"
      ],
      "text": "# LUMIX 25 Anos | 25% Cashback"
    }
  },

  "iframe#regulamento-lumix-25-anos": {
    "props": {
      "src": "https://www.aplicah.com.br/cl/portssar/regras%20cashback.pdf",
      "title": "Regulamento LUMIX 25 Anos | 25% Cashback",
      "width": "100%",
      "height": "1200px"
    }
  }
}